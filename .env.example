# ==========================================
# JONG-Q PLATFORM ENVIRONMENT CONFIGURATION
# (การตั้งค่าตัวแปรสภาพแวดล้อมสำหรับ Jong-Q บน Cloudflare)
# ==========================================

# ------------------------------------------
# 1. APPLICATION & DOMAIN (Cloudflare Domain)
# ------------------------------------------
# URL โดเมนของระบบ (ที่ผูกไว้กับ Cloudflare หรือ Localhost)
NEXT_PUBLIC_APP_URL="https://jong-q.yourdomain.com"
NODE_ENV="development"

# ------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------
# สำหรับ Localhost ใช้ SQLite:
DATABASE_URL="file:./dev.db"

# สำหรับ Production (กรณีใช้ PostgreSQL ผ่าน Cloudflare Hyperdrive หรือ Neon/Supabase):
# DATABASE_URL="postgresql://user:password@hyperdrive-or-db-host:5432/jong_q?sslmode=require"

# ------------------------------------------
# 3. LINE DEVELOPERS & LIFF CONFIGURATION
# ------------------------------------------
# LINE Front-end Framework ID (ได้จาก LINE Developers Console -> LIFF)
NEXT_PUBLIC_LIFF_ID="2000000000-XXXXXXXX"

# LINE Login Channel (สำหรับยืนยันตัวตนฝั่ง Backend)
LINE_CHANNEL_ID="2000000000"
LINE_CHANNEL_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ลิงก์สำหรับเพิ่มเพื่อน LINE Official Account ของระบบ (LINE OA)
NEXT_PUBLIC_LINE_OA_URL="https://line.me/R/ti/p/@jong-q"

# ------------------------------------------
# 4. WEB PUSH NOTIFICATIONS (VAPID KEYS)
# ------------------------------------------
# ระบบแจ้งเตือนฟรีเข้าจอมือถือ/แท็บเล็ตร้านค้า ไม่เสียค่าส่ง
# สร้างคีย์ได้ด้วยคำสั่ง: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BElxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# ------------------------------------------
# 5. SECURITY & SESSION AUTH
# ------------------------------------------
# คีย์สำหรับเข้ารหัส Session และ Token (สร้างด้วย: openssl rand -base64 32)
AUTH_SECRET="super-secret-random-key-change-in-production"

# รหัสผ่านเริ่มต้นสำหรับ Super Admin ครั้งแรก
ADMIN_DEFAULT_PHONE="0800000000"
ADMIN_DEFAULT_PASSWORD="admin_change_this_password"

# ------------------------------------------
# 6. CLOUDFLARE TURNSTILE (ระบบป้องกันบอทสแปม - แนะนำ)
# ------------------------------------------
# ป้องกันการยิงสแปมจองคิว โดยไม่ต้องให้ลูกค้าแก้แคปช่าภาพให้เสียเวลา
NEXT_PUBLIC_CF_TURNSTILE_SITE_KEY=""
CF_TURNSTILE_SECRET_KEY=""
